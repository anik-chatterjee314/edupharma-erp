{
  "name": "edupharma-erp-server",
  "version": "1.0.0",
  "description": "EduPharma Group Pharmacy Academy ERP - Backend API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "zod": "^3.25.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}
